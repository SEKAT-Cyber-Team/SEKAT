SEKAT_AGENT_API_KEY=replace-with-a-long-random-agent-key
SEKAT_ADMIN_API_KEY=replace-with-a-long-random-admin-key
SEKAT_DB_PATH=/data/sekat.db
SEKAT_CORS_ORIGINS=http://localhost:8080
SEKAT_AUTO_ISOLATE=false
SEKAT_ENV=development
SEKAT_API_URL=http://127.0.0.1:8000
SEKAT_API_KEY=replace-with-the-same-agent-key
SEKAT_HOST_ID=lab-endpoint-01
SEKAT_WATCH_PATHS=/tmp/sekat-lab
SEKAT_CANARY_PATH=/tmp/sekat-lab/SEKAT_CANARY.txt
SEKAT_HEARTBEAT_SECONDS=10
SEKAT_COMMAND_POLL_SECONDS=3
SEKAT_NETWORK_SAMPLE_SECONDS=5
SEKAT_SIMULATED_QUARANTINE=true
