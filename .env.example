# Backend credentials: generate distinct random values (>=24 characters).
SEKAT_AGENT_API_KEY=replace-with-a-long-random-agent-key
SEKAT_ADMIN_API_KEY=replace-with-a-long-random-admin-key

# Persistence and API policy
SEKAT_DB_PATH=/data/sekat.db
SEKAT_CORS_ORIGINS=http://localhost:8080
SEKAT_AUTO_ISOLATE=false
SEKAT_ENV=development

# Safe default: only this host can reach the API.
# For an agent in a separate lab VM, set this to the Docker host's
# specific host-only interface IP (never use 0.0.0.0 for the demo).
SEKAT_BIND_HOST=127.0.0.1
